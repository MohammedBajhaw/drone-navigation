<sdf version="1.9">
  <world name="disaster_office">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.8 0.8 0.8 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Willow Garage Main Model -->
    <include>
      <uri>model://willowgarage</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Victims (ArUco Markers) from Disaster Platform -->
    <include>
      <name>Victim0</name>
      <uri>/home/mohammed/disaster_platform/src/linorobot2/linorobot2_gazebo/models/aruco_victim_0</uri>
      <pose>2.0 0.0 0.5 0 0 3.14</pose>
    </include>

    <include>
      <name>Victim1</name>
      <uri>/home/mohammed/disaster_platform/src/linorobot2/linorobot2_gazebo/models/aruco_victim_1</uri>
      <pose>5.0 0.0 0.5 0 0 3.14</pose>
    </include>

    <include>
      <name>Victim2</name>
      <uri>/home/mohammed/disaster_platform/src/linorobot2/linorobot2_gazebo/models/aruco_victim_2</uri>
      <pose>3.0 3.0 0.5 0 0 -1.57</pose>
    </include>

  </world>
</sdf>
